+/// Flux patch (interface scale): a size `factor` times larger.
+fn scale_size(size: Size<Pixels>, factor: f32) -> Size<Pixels> {
+    Size {
+        width: size.width * factor,
+        height: size.height * factor,
+    }
+}
+
+/// Flux patch (interface scale): bounds `factor` times larger, from the window's top-left corner.
+pub(crate) fn scale_bounds(bounds: Bounds<Pixels>, factor: f32) -> Bounds<Pixels> {
+    Bounds {
+        origin: bounds.origin * factor,
+        size: scale_size(bounds.size, factor),
     }
