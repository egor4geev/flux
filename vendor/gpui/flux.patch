+    }
+}
+
+/// Flux patch: the app keeps running.
+unsafe extern "C" fn reply_to_should_terminate_no(_: *mut c_void) {
+    unsafe {
+        let app = NSApplication::sharedApplication(nil);
+        let _: () = msg_send![app, replyToApplicationShouldTerminate: NO];
