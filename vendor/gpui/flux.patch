+    /// Flux patch (interface scale): shows the whole window `scale` times larger (or smaller), as
+    /// zooming a web page: the window lays out a viewport `scale` times smaller than its content
+    /// size and draws it with the display's scale factor times `scale`, so text, images, borders
+    /// and shadows all scale together and stay sharp. Positions from the platform (the mouse, file
+    /// drops, the input method) are divided by the scale, positions given to it multiplied; the
+    /// window's bounds and the displays stay in the screen's points.
+    pub fn set_ui_scale(&mut self, scale: f32, cx: &mut App) {
+        let scale = if scale.is_finite() && scale > 0. {
+            scale
+        } else {
+            1.
+        };
+        if scale == self.ui_scale {
