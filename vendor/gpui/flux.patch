+    /// Flux patch (headless scenario screenshots): renders `scene` into an offscreen texture the
+    /// size of the drawable and returns its pixels — RGBA with premultiplied alpha (the glass
+    /// behind a transparent window is not there). Needs neither the window server nor a visible
+    /// window: it works on a locked screen and for an occluded window.
+    pub fn render_to_image(&mut self, scene: &Scene) -> Option<image::RgbaImage> {
+        let drawable_size = self.layer.drawable_size();
+        let (width, height) = (
+            drawable_size.width.ceil() as u64,
+            drawable_size.height.ceil() as u64,
+        );
+        if width == 0 || height == 0 {
+            return None;
+        }
+        let viewport_size: Size<DevicePixels> =
+            size((width as i32).into(), (height as i32).into());
+        let descriptor = metal::TextureDescriptor::new();
+        descriptor.set_texture_type(metal::MTLTextureType::D2);
+        descriptor.set_pixel_format(MTLPixelFormat::BGRA8Unorm);
+        descriptor.set_width(width);
+        descriptor.set_height(height);
+        descriptor.set_usage(
+            metal::MTLTextureUsage::RenderTarget | metal::MTLTextureUsage::ShaderRead,
+        );
+        descriptor.set_storage_mode(metal::MTLStorageMode::Managed);
+        let texture = self.device.new_texture(&descriptor);
+        loop {
+            let mut instance_buffer = self.instance_buffer_pool.lock().acquire(&self.device);
+            match self.draw_primitives(scene, &mut instance_buffer, &texture, viewport_size) {
+                Ok(command_buffer) => {
+                    let blit = command_buffer.new_blit_command_encoder();
+                    blit.synchronize_resource(&texture);
+                    blit.end_encoding();
+                    command_buffer.commit();
+                    command_buffer.wait_until_completed();
+                    self.instance_buffer_pool.lock().release(instance_buffer);
+                    break;
+                }
+                Err(err) => {
+                    log::error!("failed to render offscreen: {err}");
+                    let mut instance_buffer_pool = self.instance_buffer_pool.lock();
+                    let buffer_size = instance_buffer_pool.buffer_size;
+                    if buffer_size >= 256 * 1024 * 1024 {
+                        return None;
+                    }
+                    instance_buffer_pool.reset(buffer_size * 2);
+                }
+            }
+        }
+        let mut bytes = vec![0u8; (width * height * 4) as usize];
+        texture.get_bytes(
+            bytes.as_mut_ptr() as *mut c_void,
+            width * 4,
+            metal::MTLRegion::new_2d(0, 0, width, height),
+            0,
+        );
+        // BGRA → RGBA.
+        for pixel in bytes.chunks_exact_mut(4) {
+            pixel.swap(0, 2);
+        }
+        image::RgbaImage::from_raw(width as u32, height as u32, bytes)
+    }
